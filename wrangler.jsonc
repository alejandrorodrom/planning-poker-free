{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "planning-poker-free",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "env": {
    "staging": {
      "name": "planning-poker-free-staging",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOM",
            "class_name": "Room"
          }
        ]
      }
    }
  }
}
