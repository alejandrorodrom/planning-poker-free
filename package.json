{
  "name": "planning-poker-free",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time Planning Poker for Scrum teams — rooms, WebSockets and Durable Objects on Cloudflare Workers. No accounts required.",
  "license": "MIT",
  "author": {
    "name": "Alejandro Rodriguez Romero",
    "url": "https://www.linkedin.com/in/alejandro-rodriguez-romero/"
  },
  "homepage": "https://github.com/alejandrorodrom/planning-poker-free#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrorodrom/planning-poker-free.git"
  },
  "bugs": {
    "url": "https://github.com/alejandrorodrom/planning-poker-free/issues"
  },
  "keywords": [
    "planning-poker",
    "scrum",
    "agile",
    "story-points",
    "estimation",
    "svelte",
    "sveltekit",
    "typescript",
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "websockets",
    "realtime"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "gen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging"
  },
  "dependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@oselvar/sveltekit-add-worker-exports": "^2.1.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "cookie": "^1.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260730.1": true,
    "workerd@1.20260801.1": true
  }
}
