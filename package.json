{
  "name": "planning-poker-free",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "gen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@oselvar/sveltekit-add-worker-exports": "^2.1.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^20",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@img/sharp-freebsd-wasm32": "-",
    "@img/sharp-webcontainers-wasm32": "-",
    "@img/sharp-wasm32": "-"
  },
  "description": "Open-source web tool for SCRUM teams to estimate story complexity",
  "dependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0"
  }
}
